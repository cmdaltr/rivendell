def acquire_memory(mem_tool, command_params, gandalf_host):
    with ZipFile("/tmp/gandalf/{}.zip".format(mem_tool), "r") as mem_tool_zip:
        mem_tool_zip.extractall("/tmp/gandalf/")
    os.chdir("/tmp/gandalf/")
    subprocess.Popen(
        command_params, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    ).communicate()
    if (
        (
            mem_tool == "avml-main"
            and os.path.exists(
                "/tmp/gandalf/gandalf/acquisitions/{}/artefacts/{}.mem".format(
                    gandalf_host, gandalf_host
                )
            )
        )
        or mem_tool == "osxpmem.app"
        and os.path.exists(
            "/tmp/gandalf/gandalf/acquisitions/{}/artefacts/mem.aff4".format(
                gandalf_host
            )
        )
    ):
        print(
            "       \033[1;32mAcquired memory dump from '{}'\033[1;m".format(
                gandalf_host,
            )
        )
    else:
        print(
            "       \033[1;31mUnable to acquire memory dump from '{}'\033[1;m".format(
                gandalf_host,
            )
        )


def collect_volatile_data(gandalf_artefact_destination):
    # Order of volatility (RFC 3227): connections change by the second, then processes
    os_platform = str(platform.uname())
    # First line is what Elrond reads: <host>::<Linux|macOS>
    elrond_platform = "macOS" if platform.system() == "Darwin" else platform.system()
    with open(
        os.path.join(gandalf_artefact_destination, "host.info"), "w"
    ) as platform_info:
        platform_info.write("{}::{}\n{}\n".format(platform.node(), elrond_platform, os_platform))
    try:
        netstat = str(
            subprocess.Popen(
                ["netstat"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            ).communicate()[0]
        )[2:-3]
        with open(
            os.path.join(gandalf_artefact_destination, "netstat.info"), "w"
        ) as netstat_info:
            netstat_info.write(netstat)
        audit_log(os.path.dirname(gandalf_artefact_destination), "netstat.info")
    except:
        pass
    try:
        ss = str(
            subprocess.Popen(
                ["ss"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            ).communicate()[0]
        )[2:-3]
        with open(
            os.path.join(gandalf_artefact_destination, "ss.info"), "w"
        ) as ss_info:
            ss_info.write(ss)
        audit_log(os.path.dirname(gandalf_artefact_destination), "ss.info")
    except:
        pass
    processes = str(
        subprocess.Popen(
            ["ps", "aux"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).communicate()[0]
    )[2:-3]
    with open(
        os.path.join(gandalf_artefact_destination, "process.info"), "w"
    ) as process_info:
        process_info.write(processes)
    audit_log(os.path.dirname(gandalf_artefact_destination), "process.info")
    audit_log(os.path.dirname(gandalf_artefact_destination), "host.info")
    print(
        "      \033[1;32mAcquired volatile data from '{}'\033[1;m".format(
            gandalf_artefact_destination.split("/")[-2]
        )
    )


