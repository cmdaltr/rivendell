#!/usr/bin/env python3 -tt
import csv
import hashlib
import os
import platform
import shutil
import subprocess
from datetime import datetime
from zipfile import ZipFile


def audit_log(gandalf_host, artefact):
    now_time = "{}Z".format(str(datetime.now()).replace(" ", "T"))
    with open(os.path.join(gandalf_host, "log.audit"), "a") as gandalf_audit:
        gandalf_audit.write(
            "{}Z,{},{},collected\n".format(
                now_time, gandalf_host.split("/")[-1], artefact
            )
        )


def audit_meta(gandalf_host, artefact):
    sha256 = hashlib.sha256()
    with open(artefact, "rb") as metafile:
        buffer = metafile.read(262144)
        while len(buffer) > 0:
            sha256.update(buffer)
            buffer = metafile.read(262144)
    artefact_hash = sha256.hexdigest()
    with open(os.path.join(gandalf_host, "log.meta"), "a") as gandalf_meta:
        gandalf_meta.write(
            "{},{},{}\n".format(gandalf_host.split("/")[-1], artefact, artefact_hash)
        )


def make_artefact_dir(gandalf_artefact_destination, artefact_output_dir):
    if not os.path.exists(
        os.path.join(gandalf_artefact_destination, artefact_output_dir)
    ):
        os.makedirs(os.path.join(gandalf_artefact_destination, artefact_output_dir))
    else:
        pass


def listdir_readable(path):
    """os.listdir, but an unreadable directory (another user's home when
    collecting unprivileged) lists as empty instead of ending the run."""
    try:
        return os.listdir(path)
    except (PermissionError, FileNotFoundError):
        return []


def copy_file(source, destination):
    if os.stat(source).st_size > 0:
        try:
            shutil.copy2(source, destination)
        except PermissionError:
            pass
        except FileExistsError:
            pass
    else:
        pass


def copy_dir(source, destination):
    if os.path.exists(source) and len(listdir_readable(source)) != 0:
        try:
            shutil.copytree(source, destination)
        except PermissionError:
            pass
        except FileExistsError:
            pass
        except shutil.Error:
            pass
    else:
        pass


def print_progress(artefact, gandalf_host, artefact_output_dir, previously_collected):
    if os.path.exists(artefact):
        if (
            artefact_output_dir == "logs"
            or artefact_output_dir == "plists"
            or artefact_output_dir == "services"
        ):
            if artefact_output_dir == "logs":
                print(
                    "      \033[1;32mAcquired {} {} from '{}'\033[1;m".format(
                        artefact.split("/")[-3].lower(),
                        artefact_output_dir,
                        gandalf_host,
                    )
                )
            elif artefact_output_dir == "plists":
                if len(artefact.split("/")) == 5:
                    print(
                        "      \033[1;32mAcquired {} {} {} from '{}'\033[1;m".format(
                            artefact.split("/")[-4].lower(),
                            artefact.split("/")[-2].lower(),
                            artefact_output_dir,
                            gandalf_host,
                        )
                    )
                elif len(artefact.split("/")) == 4:
                    print(
                        "      \033[1;32mAcquired {} {} {} from '{}'\033[1;m".format(
                            artefact.split("/")[-3].lower(),
                            artefact.split("/")[-2].lower(),
                            artefact_output_dir,
                            gandalf_host,
                        )
                    )
                else:
                    pass
            else:
                print(
                    "      \033[1;32mAcquired {} from '{}'\033[1;m".format(
                        artefact_output_dir, gandalf_host
                    )
                )
        elif artefact_output_dir == "memory":
            if artefact_output_dir not in str(previously_collected):
                print(
                    "      \033[1;32mAcquired {} artefacts from '{}'\033[1;m".format(
                        artefact_output_dir, gandalf_host
                    )
                )
            else:
                pass
            previously_collected.append("memory")
        elif artefact_output_dir == "cron":
            if artefact_output_dir not in str(previously_collected):
                print(
                    "      \033[1;32mAcquired {} artefacts from '{}'\033[1;m".format(
                        artefact_output_dir, gandalf_host
                    )
                )
            else:
                pass
            previously_collected.append("cron")
        elif artefact_output_dir == "conf":
            print(
                "      \033[1;32mAcquired configuration files from '{}'\033[1;m".format(
                    gandalf_host
                )
            )
        elif artefact_output_dir == "user":
            print(
                "      \033[1;32mAcquired {} artefacts for '{}' from '{}'\033[1;m".format(
                    artefact_output_dir,
                    gandalf_host.split("+")[1],
                    gandalf_host.split("+")[0],
                )
            )
        elif artefact_output_dir != "":
            print(
                "      \033[1;32mAcquired {} artefacts from '{}'\033[1;m".format(
                    artefact_output_dir, gandalf_host
                )
            )
        else:
            pass
    else:
        pass
    return previously_collected


def acquire_memory(mem_tool, command_params, gandalf_host):
    with ZipFile("/tmp/gandalf/{}.zip".format(mem_tool), "r") as mem_tool_zip:
        mem_tool_zip.extractall("/tmp/gandalf/")
    os.chdir("/tmp/gandalf/")
    subprocess.Popen(
        command_params, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    ).communicate()
    if (
        (
            mem_tool == "avml-main"
            and os.path.exists(
                "/tmp/gandalf/gandalf/acquisitions/{}/artefacts/{}.mem".format(
                    gandalf_host, gandalf_host
                )
            )
        )
        or mem_tool == "osxpmem.app"
        and os.path.exists(
            "/tmp/gandalf/gandalf/acquisitions/{}/artefacts/mem.aff4".format(
                gandalf_host
            )
        )
    ):
        print(
            "       \033[1;32mAcquired memory dump from '{}'\033[1;m".format(
                gandalf_host,
            )
        )
    else:
        print(
            "       \033[1;31mUnable to acquire memory dump from '{}'\033[1;m".format(
                gandalf_host,
            )
        )


def collect_volatile_data(gandalf_artefact_destination):
    os_platform = str(platform.uname())
    # First line is what Elrond reads: <host>::<Linux|macOS>
    elrond_platform = "macOS" if platform.system() == "Darwin" else platform.system()
    with open(
        os.path.join(gandalf_artefact_destination, "host.info"), "w"
    ) as platform_info:
        platform_info.write("{}::{}\n{}\n".format(platform.node(), elrond_platform, os_platform))
    processes = str(
        subprocess.Popen(
            ["ps", "aux"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).communicate()[0]
    )[2:-3]
    with open(
        os.path.join(gandalf_artefact_destination, "process.info"), "w"
    ) as process_info:
        process_info.write(processes)
    try:
        netstat = str(
            subprocess.Popen(
                ["netstat"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            ).communicate()[0]
        )[2:-3]
        with open(
            os.path.join(gandalf_artefact_destination, "netstat.info"), "w"
        ) as netstat_info:
            netstat_info.write(netstat)
    except:
        pass
    try:
        ss = str(
            subprocess.Popen(
                ["ss"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            ).communicate()[0]
        )[2:-3]
        with open(
            os.path.join(gandalf_artefact_destination, "ss.info"), "w"
        ) as ss_info:
            ss_info.write(ss)
    except:
        pass
    print(
        "      \033[1;32mAcquired volatile data from '{}'\033[1;m".format(
            gandalf_artefact_destination.split("/")[-2]
        )
    )


def collect_browser_artefact(
    artefact_source, gandalf_artefact_destination, user_profile, browser, browser_file
):
    if not os.path.exists(
        os.path.join(
            gandalf_artefact_destination,
            "browsers",
        )
    ):
        os.mkdir(
            os.path.join(
                gandalf_artefact_destination,
                "browsers",
            )
        )
    else:
        pass
    if not os.path.exists(
        os.path.join(
            gandalf_artefact_destination,
            "browsers",
            browser,
        )
    ):
        os.mkdir(
            os.path.join(
                gandalf_artefact_destination,
                "browsers",
                browser,
            )
        )
    else:
        pass
    shutil.copy2(
        artefact_source,
        os.path.join(
            gandalf_artefact_destination,
            "browsers",
            browser,
            "{}+{}".format(
                user_profile,
                browser_file,
            ),
        ),
    )
    print(
        "      \033[1;32mAcquired '{}' browser artefacts for '{}' from '{}'\033[1;m".format(
            browser,
            user_profile,
            gandalf_artefact_destination.split("/")[-2],
        )
    )


MACOS_SINGLE_FILES = {
    # file -> (folder under artefacts/, name) for single files the main loop's
    # directory walk can't pick up
    "/Library/Application Support/com.apple.TCC/TCC.db": ("tcc", "system+TCC.db"),
    "/private/var/db/CoreDuet/Knowledge/knowledgeC.db": ("coreduet", "system+knowledgeC.db"),
    "/System/Library/CoreServices/SystemVersion.plist": ("plists", "systemversion+SystemVersion.plist"),
    "/etc/sudoers": ("conf", "etc+sudoers"),
    "/etc/ssh/sshd_config": ("conf", "etc+ssh+sshd_config"),
}
MACOS_USER_FILES = (
    ".zsh_history", ".zshrc", ".zprofile", ".zshenv", ".profile",
)
SHARED_MAX_BYTES = 10 * 1024 * 1024


def _collect_one(source, destination, gandalf_host):
    """Copy one file (if readable and not empty), log it and hash it."""
    try:
        if not os.path.isfile(source) or os.path.getsize(source) == 0:
            return False
        os.makedirs(os.path.dirname(destination), exist_ok=True)
        shutil.copy2(source, destination)
    except (PermissionError, OSError):
        return False
    audit_log(gandalf_host, source)
    audit_meta(gandalf_host, destination)
    return True


def collect_macos_extras(gandalf_artefact_destination, gandalf_host):
    """
    macOS artefacts the system_artefacts walk misses: zsh history (the default
    shell since 10.15), per-user LaunchAgents and preferences, quarantine
    events, TCC and KnowledgeC databases, and /Users/Shared (a common staging
    folder). Protected files need Full Disk Access and are skipped otherwise.
    """
    dest = gandalf_artefact_destination
    for source, (folder, name) in MACOS_SINGLE_FILES.items():
        _collect_one(source, os.path.join(dest, folder, name), gandalf_host)
    for agents_dir, prefix in (
        ("/System/Library/LaunchAgents", "system+launchagents-"),
    ):
        if os.path.isdir(agents_dir):
            for plist in sorted(listdir_readable(agents_dir)):
                if plist.endswith(".plist"):
                    _collect_one(os.path.join(agents_dir, plist), os.path.join(dest, "plists", prefix + plist), gandalf_host)
    for user in sorted(listdir_readable("/Users")) if os.path.isdir("/Users") else []:
        home = os.path.join("/Users", user)
        if user == "Shared" or user.startswith(".") or not os.path.isdir(home):
            continue
        for name in MACOS_USER_FILES:
            _collect_one(os.path.join(home, name), os.path.join(dest, "user", user, name), gandalf_host)
        for sessions in (".zsh_sessions", ".bash_sessions"):
            sdir = os.path.join(home, sessions)
            if os.path.isdir(sdir):
                for name in sorted(listdir_readable(sdir)):
                    if name.endswith(".history"):
                        _collect_one(os.path.join(sdir, name), os.path.join(dest, "user", user, "sessions", name), gandalf_host)
        for subdir, prefix in (("LaunchAgents", user + "+launchagents+"), ("Preferences", user + "+")):
            pdir = os.path.join(home, "Library", subdir)
            if os.path.isdir(pdir):
                for plist in sorted(listdir_readable(pdir)):
                    if plist.endswith(".plist"):
                        _collect_one(os.path.join(pdir, plist), os.path.join(dest, "plists", prefix + plist), gandalf_host)
        _collect_one(
            os.path.join(home, "Library", "Preferences", "com.apple.LaunchServices.QuarantineEventsV2"),
            os.path.join(dest, "user", user, "QuarantineEventsV2"),
            gandalf_host,
        )
        _collect_one(
            os.path.join(home, "Library", "Application Support", "com.apple.TCC", "TCC.db"),
            os.path.join(dest, "tcc", user + "+TCC.db"),
            gandalf_host,
        )
    shared = "/Users/Shared"
    for root, dirs, files in os.walk(shared):
        if root[len(shared):].count(os.sep) >= 3:
            dirs[:] = []
        for name in files:
            source = os.path.join(root, name)
            try:
                if os.path.getsize(source) > SHARED_MAX_BYTES:
                    continue
            except OSError:
                continue
            rel = os.path.relpath(source, shared).replace(os.sep, "+")
            _collect_one(source, os.path.join(dest, "shared", rel), gandalf_host)
    print(
        "      \033[1;32mAcquired macOS shell history, persistence and staging artefacts from '{}'\033[1;m".format(
            gandalf_host.split("/")[-1]
        )
    )


# Linux artefacts beyond the system_artefacts walk, into artefacts/linux/ under their
# path with '/' as '+'. Elrond's collect/linux.py and gandalf.sh carry the same lists.
LINUX_EXTRA_FILES = (
    "/etc/ld.so.preload", "/etc/ld.so.conf", "/etc/environment", "/etc/profile", "/etc/bash.bashrc",
    "/etc/bashrc", "/etc/rc.local", "/etc/sudoers", "/run/utmp", "/var/run/utmp", "/var/log/wtmp",
    "/var/log/btmp", "/var/log/lastlog", "/var/log/faillog",
    "/var/lib/wtmpdb/wtmp.db", "/var/lib/lastlog/lastlog2.db",
)
# directory, depth, largest file, file name suffixes (empty: any)
LINUX_EXTRA_DIRS = (
    ("/etc/ld.so.conf.d", 1, 1 << 20, ()),
    ("/etc/profile.d", 1, 1 << 20, ()),
    ("/etc/pam.d", 1, 1 << 20, ()),
    ("/etc/sudoers.d", 1, 1 << 20, ()),
    ("/etc/udev/rules.d", 1, 1 << 20, (".rules",)),
    ("/usr/lib/udev/rules.d", 1, 1 << 20, (".rules",)),
    ("/lib/udev/rules.d", 1, 1 << 20, (".rules",)),
    ("/etc/systemd/system-generators", 1, 10 << 20, ()),
    ("/etc/systemd/user-generators", 1, 10 << 20, ()),
    ("/usr/local/lib/systemd/system-generators", 1, 10 << 20, ()),
    ("/etc/xdg/autostart", 1, 1 << 20, (".desktop",)),
    ("/etc/update-motd.d", 1, 1 << 20, ()),
    ("/etc/nginx", 3, 1 << 20, ()),
    ("/etc/apache2", 3, 1 << 20, ()),
    ("/etc/httpd", 3, 1 << 20, ()),
)
LINUX_WEB_ROOTS = ("/var/www", "/srv/www", "/srv/http", "/usr/share/nginx/html")
LINUX_WEB_SCRIPTS = (".php", ".phtml", ".php3", ".php4", ".php5", ".php7", ".phar", ".inc", ".jsp", ".jspx",
                     ".asp", ".aspx", ".ashx", ".asmx", ".cgi", ".pl", ".py", ".sh", ".cfm")
LINUX_WEB_MAX_FILES = 5000
# under each home, into user/<user>/ (Elrond reads them as user_profiles/<user>+<name>)
LINUX_USER_FILES = (".zsh_history", ".viminfo", ".lesshst", ".python_history", ".mysql_history",
                    ".psql_history", ".wget-hsts", ".local/share/recently-used.xbel")
LINUX_USER_DIRS = ((".config/autostart", (".desktop",)), (".config/systemd/user", (".service", ".timer")))
LINUX_TMP_DIRS = ("/tmp", "/var/tmp", "/dev/shm")
LINUX_HASH_MAX_BYTES = 100 * 1024 * 1024


def _walk_files(top, depth):
    """Files under top, at most depth levels down, without following symlinks."""
    top_depth = top.rstrip("/").count("/")
    for root, dirs, files in os.walk(top):
        if root.count("/") - top_depth + 1 >= depth:
            dirs[:] = []
        for name in files:
            yield os.path.join(root, name)


def _sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _executable_kind(path):
    try:
        with open(path, "rb") as fh:
            head = fh.read(4)
        mode = os.lstat(path).st_mode
    except OSError:
        return ""
    if head == b"\x7fELF":
        return "elf"
    if head[:2] == b"#!":
        return "script"
    return "executable" if mode & 0o111 else ""


def _write_listing(path, rows, gandalf_host):
    if not rows:
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", newline="") as out:
        writer = csv.DictWriter(out, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)
    audit_meta(gandalf_host, path)


def kernel_module_listing():
    """Loaded modules from /proc/modules with the file each was loaded from and its hash.
    Path is '?' where modinfo isn't installed, '' where it can't find the module."""
    rows = []
    have_modinfo = shutil.which("modinfo") is not None
    try:
        with open("/proc/modules") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return rows
    for line in lines:
        fields = line.split()
        if len(fields) < 6:
            continue
        path = "?"
        if have_modinfo:
            result = subprocess.run(["modinfo", "-n", fields[0]], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            path = result.stdout.decode(errors="replace").strip()
        digest = ""
        if path not in ("", "?", "(builtin)") and os.path.isfile(path):
            try:
                digest = _sha256_file(path)
            except OSError:
                pass
        rows.append({"Name": fields[0], "Size": fields[1], "Instances": fields[2], "State": fields[4],
                     "Taint": fields[6].strip("()") if len(fields) > 6 else "", "Path": path, "SHA256": digest})
    return rows


def collect_linux_extras(gandalf_artefact_destination, gandalf_host):
    """
    Linux persistence, login-record and history artefacts the system_artefacts walk
    misses (preload, PAM, sudoers.d, udev, generators, autostart, utmp/wtmp/btmp,
    lastlog, web roots, extra shell histories), plus listings of loaded kernel
    modules and of executables in the temp directories.
    """
    linux = os.path.join(gandalf_artefact_destination, "linux")
    seen = set()

    def take(source, destination, limit=None):
        try:
            if not os.path.isfile(source) or os.path.islink(source):
                return
            real = os.path.realpath(source)
            size = os.path.getsize(source)
            if real in seen or (limit and size > limit):
                return
            seen.add(real)
        except OSError:
            return
        _collect_one(source, destination, gandalf_host)

    def flat(path):
        return os.path.join(linux, path.lstrip("/").replace("/", "+"))

    for path in LINUX_EXTRA_FILES:
        take(path, flat(path), 64 << 20)
    for top, depth, limit, suffixes in LINUX_EXTRA_DIRS:
        if os.path.isdir(top):
            for source in _walk_files(top, depth):
                if not suffixes or source.endswith(suffixes):
                    take(source, flat(source), limit)
    web = 0
    for top in LINUX_WEB_ROOTS:
        if os.path.isdir(top):
            for source in _walk_files(top, 6):
                if web >= LINUX_WEB_MAX_FILES:
                    break
                if source.lower().endswith(LINUX_WEB_SCRIPTS):
                    take(source, flat(source), 1 << 20)
                    web += 1
    homes = ["/root"] + sorted(os.path.join("/home", h) for h in listdir_readable("/home")) if os.path.isdir("/home") else ["/root"]
    for home in homes:
        if not os.path.isdir(home):
            continue
        user = os.path.basename(home)
        for name in LINUX_USER_FILES:
            take(os.path.join(home, name), os.path.join(gandalf_artefact_destination, "user", user, os.path.basename(name)))
        for sub, suffixes in LINUX_USER_DIRS:
            if os.path.isdir(os.path.join(home, sub)):
                for source in _walk_files(os.path.join(home, sub), 1):
                    if source.endswith(suffixes):
                        take(source, flat(source), 1 << 20)
    _write_listing(os.path.join(linux, "gandalf+kernel_modules.csv"), kernel_module_listing(), gandalf_host)
    rows = []
    for top in LINUX_TMP_DIRS:
        if not os.path.isdir(top):
            continue
        for source in _walk_files(top, 3):
            if source.startswith("/tmp/gandalf/"):
                continue
            kind = _executable_kind(source)
            if not kind:
                continue
            try:
                info = os.lstat(source)
                digest = _sha256_file(source) if info.st_size <= LINUX_HASH_MAX_BYTES else ""
            except OSError:
                continue
            rows.append({"Path": source, "Size": info.st_size, "Mode": oct(info.st_mode & 0o7777), "UID": info.st_uid,
                         "Kind": kind, "SHA256": digest, "MTime": int(info.st_mtime)})
    _write_listing(os.path.join(linux, "gandalf+tmp_executables.csv"), rows, gandalf_host)
    print(
        "      \033[1;32mAcquired Linux persistence, login-record and history artefacts from '{}'\033[1;m".format(
            gandalf_host.split("/")[-1]
        )
    )


def encrypt_archive(encryption_key, gandalf_host):
    """Fernet-encrypt <host>.zip to <host>.zip.enc and remove the plaintext archive.
    encryption_key is the key itself (gandalf.py writes it into this script), not a Fernet."""
    from cryptography.fernet import Fernet

    with open("{}.zip".format(gandalf_host), "rb") as zipfile:
        zip_archive = zipfile.read()
    encrypted = Fernet(encryption_key).encrypt(zip_archive)
    with open("{}.zip.enc".format(gandalf_host), "wb") as encrypted_zipfile:
        encrypted_zipfile.write(encrypted)
    os.remove("{}.zip".format(gandalf_host))
    print()


def archive_artefacts(encryption, encryption_object, gandalf_directory, gandalf_host):
    gandalf_archive = os.path.join(
        gandalf_directory, "{}.zip".format(gandalf_host.split("/")[-1])
    )
    cwd = os.getcwd()
    os.chdir(os.path.join(gandalf_host, ".."))
    with ZipFile(gandalf_archive, "w") as gandalf_archive:
        for archiveroot, _, archivefiles in os.walk(gandalf_host.split("/")[-1]):
            try:
                for archivefile in archivefiles:
                    gandalf_archive.write(os.path.join(archiveroot, archivefile))
            except ValueError as error:
                if "ZIP does not support timestamps before 1980" in str(error):
                    print(
                        "       \033[1;31mWARNING: '{}' could not be archived for '{}' as the timestamp is before 1980\033[1;m".format(
                            os.path.join(
                                archiveroot.split("/artefacts")[1], archivefile
                            ),
                            gandalf_host.split("/")[-1],
                        )
                    )
                else:
                    print("       \033[1;33mERROR: {}\033[1;m".format(error))
    if encryption.title() == "Key":
        encrypt_archive(encryption_object, gandalf_host)
    elif encryption.title() == "Password":
        encrypt_archive(encryption_object, gandalf_host)
    else:
        pass
    os.chdir(cwd)


def acquire_artefacts(
    encryption,
    system_artefacts,
    output_directory,
    memory,
    access_times,
    collect_files,
    encryption_object,
    gandalf_directory,
    gandalf_host,
):
    previously_collected = []
    os.mkdir(gandalf_host)
    with open(os.path.join(gandalf_host, "log.audit"), "a") as gandalf_audit:
        gandalf_audit.write("datetime,hostname,artefact,collected\n")
    gandalf_artefact_destination = os.path.join(gandalf_host, "artefacts")
    os.mkdir(gandalf_artefact_destination)
    os_platform = str(platform.uname())
    if memory != "None":
        print(
            "      Acquiring memory dump from '{}'".format(
                gandalf_host.split("/")[-1],
            )
        )
        if (
            "GNU/Linux" in os_platform
            and "Linux" in os_platform
            and "Darwin" not in os_platform
        ):
            command_params = [
                "sudo chmod +x avml && sudo ./avml /tmp/gandalf/gandalf/acquisitions/{}/artefacts/{}.mem".format(
                    gandalf_host.split("/")[-1], gandalf_host.split("/")[-1]
                )
            ]
            acquire_memory("avml-main", command_params, gandalf_host.split("/")[-1])
        elif (
            "Darwin" in os_platform
            and "GNU/Linux" not in os_platform
            and "Linux" not in os_platform
        ):
            command_params = [
                "sudo chown -R root:wheel osxpmem.app/ && sudo chmod +x osxpmem.app/osxpmem && sudo osxpmem.app/osxpmem -o /tmp/gandalf/gandalf/acquisitions/{}/artefacts/mem.aff4 && sudo osxpmem.app/osxpmem -e /dev/pmem -o /tmp/gandalf/gandalf/acquisitions/{}/artefacts/mem.raw /tmp/gandalf/gandalf/acquisitions/{}/artefacts/mem.aff4".format(
                    gandalf_host.split("/")[-1],
                    gandalf_host.split("/")[-1],
                    gandalf_host.split("/")[-1],
                )
            ]
            acquire_memory("osxpmem.app", command_params, gandalf_host.split("/")[-1])
        else:
            print(
                "      \033[1;31mUnable to acquire memory; platform is neither Linux or macOS.\033[1;m"
            )
        print()
    else:
        pass
    collect_volatile_data(gandalf_artefact_destination)
    for artefact, artefact_output_dir in system_artefacts.items():
        if os.path.exists(artefact):
            if not artefact.endswith("/") and artefact_output_dir == "":  # file
                copy_file(artefact, gandalf_artefact_destination)
            else:  # directory
                if artefact_output_dir == "memory":
                    make_artefact_dir(gandalf_artefact_destination, artefact_output_dir)
                    if artefact.split("/")[-2] == "vm":
                        copy_file(
                            artefact,
                            os.path.join(
                                gandalf_artefact_destination,
                                artefact_output_dir,
                                "{}+{}".format(
                                    artefact.split("/")[-2], artefact.split("/")[-1]
                                ),
                            ),
                        )
                    else:
                        copy_file(
                            artefact,
                            os.path.join(
                                gandalf_artefact_destination,
                                artefact_output_dir,
                                artefact.split("/")[-1],
                            ),
                        )
                else:
                    pass
                for gandalfroot, gandalfdirs, gandalffiles in os.walk(artefact):
                    if (
                        artefact_output_dir == "boot"
                        or artefact_output_dir == "home"
                        or artefact_output_dir == "root"
                    ):
                        if not os.path.exists(
                            os.path.join(
                                gandalf_artefact_destination, gandalfroot.split("/")[1]
                            )
                        ):
                            copy_dir(
                                "/{}".format(gandalfroot.split("/")[1]),
                                os.path.join(
                                    gandalf_artefact_destination,
                                    gandalfroot.split("/")[1],
                                ),
                            )
                        else:
                            pass
                    else:
                        pass
                    if artefact_output_dir == "cron":
                        make_artefact_dir(
                            gandalf_artefact_destination, artefact_output_dir
                        )
                        for cronobject in listdir_readable(artefact):
                            if os.path.isfile(os.path.join(artefact, cronobject)):
                                copy_file(
                                    os.path.join(artefact, cronobject),
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        "{}+{}".format(
                                            artefact.split("/")[-2], cronobject
                                        ),
                                    ),
                                )
                            elif os.path.isdir(os.path.join(artefact, cronobject)):
                                copy_dir(
                                    os.path.join(artefact, cronobject),
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        "{}+{}".format(
                                            artefact.split("/")[-2], cronobject
                                        ),
                                    ),
                                )
                            else:
                                pass
                    else:
                        pass
                    if artefact_output_dir == "tmp":
                        make_artefact_dir(
                            gandalf_artefact_destination, artefact_output_dir
                        )
                        for tmpobject in listdir_readable(artefact):
                            if os.path.isfile(os.path.join(artefact, tmpobject)):
                                copy_file(
                                    os.path.join(artefact, tmpobject),
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        tmpobject,
                                    ),
                                )
                            elif (
                                os.path.isdir(os.path.join(artefact, tmpobject))
                                and "gandalf" != tmpobject
                            ):
                                copy_dir(
                                    os.path.join(artefact, tmpobject),
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        tmpobject,
                                    ),
                                )
                            else:
                                pass
                    else:
                        pass
                    if artefact_output_dir == "logs":
                        make_artefact_dir(
                            gandalf_artefact_destination, artefact_output_dir
                        )
                        for gandalffile in gandalffiles:
                            if gandalffile.endswith(".log"):
                                artefact_path = os.path.join(gandalfroot, gandalffile)
                                copy_file(
                                    artefact_path,
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        "{}+{}".format(
                                            artefact_path.split("/")[-2],
                                            artefact_path.split("/")[-1],
                                        ),
                                    ),
                                )
                            else:
                                pass
                    else:
                        pass
                    if artefact_output_dir == "plists":
                        make_artefact_dir(
                            gandalf_artefact_destination, artefact_output_dir
                        )
                        for gandalffile in gandalffiles:
                            if gandalffile.endswith(".plist"):
                                artefact_path = os.path.join(gandalfroot, gandalffile)
                                copy_file(
                                    artefact_path,
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        "{}+{}".format(
                                            artefact_path.split("/")[-2],
                                            artefact_path.split("/")[-1],
                                        ),
                                    ),
                                )
                            else:
                                pass
                    else:
                        pass
                    if artefact_output_dir == "services":
                        make_artefact_dir(
                            gandalf_artefact_destination, artefact_output_dir
                        )
                        for gandalffile in gandalffiles:
                            if (
                                gandalffile.endswith(".service")
                                or gandalffile.endswith(".socket")
                                or gandalffile.endswith(".target")
                            ):
                                artefact_path = os.path.join(gandalfroot, gandalffile)
                                copy_file(
                                    artefact_path,
                                    os.path.join(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        "{}+{}".format(
                                            artefact_path.split("/")[-2],
                                            artefact_path.split("/")[-1],
                                        ),
                                    ),
                                )
                            else:
                                pass
                    else:
                        pass
                    if artefact_output_dir == "user":
                        if gandalfroot == "/Users/":
                            for user_profile in gandalfdirs:
                                usergandalfroot = os.path.join(
                                    gandalfroot, user_profile
                                )
                                for userobject in listdir_readable(usergandalfroot):
                                    make_artefact_dir(
                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                    )
                                    if (
                                        os.path.exists(
                                            os.path.join(
                                                usergandalfroot, ".bash_history"
                                            )
                                        )
                                        or os.path.exists(
                                            os.path.join(usergandalfroot, ".bashrc")
                                        )
                                        or os.path.exists(
                                            os.path.join(usergandalfroot, ".local")
                                        )
                                        or os.path.exists(
                                            os.path.join(usergandalfroot, "Desktop")
                                        )
                                        or os.path.exists(
                                            os.path.join(usergandalfroot, "Public")
                                        )
                                    ):
                                        make_artefact_dir(
                                            os.path.join(
                                                gandalf_artefact_destination,
                                                artefact_output_dir,
                                            ),
                                            user_profile,
                                        )
                                    else:
                                        pass
                                    if os.path.isfile(
                                        os.path.join(usergandalfroot, userobject)
                                    ):
                                        if (
                                            userobject == ".bash_aliases"
                                            or userobject == ".bash_history"
                                            or userobject == ".bash_logout"
                                            or userobject == ".bashrc"
                                            or userobject == ".bash_profile"
                                            or userobject == ".bash_session"
                                        ):
                                            copy_file(
                                                os.path.join(
                                                    usergandalfroot, userobject
                                                ),
                                                os.path.join(
                                                    gandalf_artefact_destination,
                                                    artefact_output_dir,
                                                    user_profile,
                                                    userobject,
                                                ),
                                            )
                                        else:
                                            pass
                                    else:
                                        if (
                                            userobject == ".ssh"
                                            or userobject == ".Trash"
                                        ):
                                            copy_dir(
                                                os.path.join(
                                                    gandalfroot,
                                                    user_profile,
                                                    userobject,
                                                ),
                                                os.path.join(
                                                    gandalf_artefact_destination,
                                                    "user",
                                                    user_profile,
                                                    userobject.replace(".", ""),
                                                ),
                                            )
                                        elif userobject == "Library":
                                            userlibraryroot = os.path.join(
                                                gandalfroot, user_profile, userobject
                                            )
                                            for librarysubdir in listdir_readable(
                                                userlibraryroot
                                            ):
                                                if librarysubdir == "Keychains":
                                                    if os.path.exists(
                                                        os.path.join(
                                                            gandalfroot,
                                                            user_profile,
                                                            userobject,
                                                            librarysubdir,
                                                            "login.keychain",
                                                        )
                                                    ):
                                                        copy_file(
                                                            os.path.join(
                                                                gandalfroot,
                                                                user_profile,
                                                                userobject,
                                                                librarysubdir,
                                                                "login.keychain",
                                                            ),
                                                            os.path.join(
                                                                gandalf_artefact_destination,
                                                                "user",
                                                                user_profile,
                                                                "login.keychain",
                                                            ),
                                                        )
                                                    else:
                                                        pass
                                                    if os.path.exists(
                                                        os.path.join(
                                                            gandalfroot,
                                                            user_profile,
                                                            userobject,
                                                            librarysubdir,
                                                            "login.keychain",
                                                        )
                                                    ):
                                                        copy_file(
                                                            os.path.join(
                                                                gandalfroot,
                                                                user_profile,
                                                                userobject,
                                                                librarysubdir,
                                                                "login.keychain-db",
                                                            ),
                                                            os.path.join(
                                                                gandalf_artefact_destination,
                                                                "user",
                                                                user_profile,
                                                                "login.keychain-db",
                                                            ),
                                                        )
                                                    else:
                                                        pass
                                                elif librarysubdir == "Mail":
                                                    copy_dir(
                                                        os.path.join(
                                                            gandalfroot,
                                                            user_profile,
                                                            userobject,
                                                            librarysubdir,
                                                        ),
                                                        os.path.join(
                                                            gandalf_artefact_destination,
                                                            "user",
                                                            user_profile,
                                                            librarysubdir,
                                                        ),
                                                    )
                                                elif librarysubdir == "Safari":
                                                    copy_dir(
                                                        os.path.join(
                                                            gandalfroot,
                                                            user_profile,
                                                            userobject,
                                                            librarysubdir,
                                                        ),
                                                        os.path.join(
                                                            gandalf_artefact_destination,
                                                            "user",
                                                            usergandalfroot.split("/")[
                                                                -1
                                                            ],
                                                            librarysubdir,
                                                        ),
                                                    )
                                                    if os.path.exists(
                                                        os.path.join(
                                                            gandalf_artefact_destination,
                                                            "user",
                                                            usergandalfroot.split("/")[
                                                                -1
                                                            ],
                                                            librarysubdir,
                                                            "History.db",
                                                        )
                                                    ):
                                                        collect_browser_artefact(
                                                            os.path.join(
                                                                gandalfroot,
                                                                user_profile,
                                                                userobject,
                                                                librarysubdir,
                                                                "History.db",
                                                            ),
                                                            gandalf_artefact_destination,
                                                            usergandalfroot.split("/")[
                                                                -1
                                                            ],
                                                            "safari",
                                                            "History.db",
                                                        )
                                                        os.remove(
                                                            os.path.join(
                                                                gandalf_artefact_destination,
                                                                "user",
                                                                user_profile,
                                                                "safari",
                                                                "History.db",
                                                            )
                                                        )
                                                    else:
                                                        pass
                                                elif (
                                                    librarysubdir
                                                    == "Application Support"
                                                ):
                                                    for applicationdir in listdir_readable(
                                                        os.path.join(
                                                            userlibraryroot,
                                                            librarysubdir,
                                                        )
                                                    ):
                                                        if applicationdir == "Google":
                                                            if os.path.exists(
                                                                os.path.join(
                                                                    userlibraryroot,
                                                                    librarysubdir,
                                                                    applicationdir,
                                                                    "Chrome",
                                                                    "Default",
                                                                    "History",
                                                                )
                                                            ):
                                                                collect_browser_artefact(
                                                                    os.path.join(
                                                                        gandalfroot,
                                                                        user_profile,
                                                                        userobject,
                                                                        librarysubdir,
                                                                        applicationdir,
                                                                        "Chrome",
                                                                        "Default",
                                                                        "History",
                                                                    ),
                                                                    gandalf_artefact_destination,
                                                                    usergandalfroot.split(
                                                                        "/"
                                                                    )[
                                                                        -1
                                                                    ],
                                                                    "Chrome",
                                                                    "History",
                                                                )
                                                        elif (
                                                            applicationdir == "Firefox"
                                                        ):
                                                            if os.path.exists(
                                                                os.path.join(
                                                                    userlibraryroot,
                                                                    librarysubdir,
                                                                    applicationdir,
                                                                    "Firefox",
                                                                    "Profiles",
                                                                )
                                                            ):
                                                                for (
                                                                    profile
                                                                ) in os.path.join(
                                                                    userlibraryroot,
                                                                    librarysubdir,
                                                                    applicationdir,
                                                                    "Firefox",
                                                                    "Profiles",
                                                                ):
                                                                    if os.path.exists(
                                                                        os.path.join(
                                                                            userlibraryroot,
                                                                            librarysubdir,
                                                                            applicationdir,
                                                                            "Firefox",
                                                                            "Profiles",
                                                                            profile,
                                                                            "places.sqlite",
                                                                        )
                                                                    ):
                                                                        collect_browser_artefact(
                                                                            os.path.join(
                                                                                gandalfroot,
                                                                                user_profile,
                                                                                userobject,
                                                                                librarysubdir,
                                                                                applicationdir,
                                                                                "Firefox",
                                                                                "Profiles",
                                                                                profile,
                                                                                "places.sqlite",
                                                                            ),
                                                                            gandalf_artefact_destination,
                                                                            usergandalfroot.split(
                                                                                "/"
                                                                            )[
                                                                                -1
                                                                            ],
                                                                            "Firefox",
                                                                            "places.sqlite",
                                                                        )
                                                                    else:
                                                                        pass
                                                            else:
                                                                pass
                                                        else:
                                                            pass
                                                else:
                                                    pass
                                        else:
                                            pass
                                previously_collected = print_progress(
                                    artefact,
                                    "{}+{}".format(
                                        gandalf_host.split("/")[-1], user_profile
                                    ),
                                    artefact_output_dir,
                                    previously_collected,
                                )
                        else:
                            pass
                    else:
                        pass
        else:
            pass
        if artefact_output_dir != "user":
            previously_collected = print_progress(
                artefact,
                gandalf_host.split("/")[-1],
                artefact_output_dir,
                previously_collected,
            )
        else:
            pass
    if platform.system() == "Darwin":
        collect_macos_extras(gandalf_artefact_destination, gandalf_host)
    elif platform.system() == "Linux":
        collect_linux_extras(gandalf_artefact_destination, gandalf_host)
    if access_times != "None":
        print()
        print(
            "      \033[1;32mObtaining files' LastAccess times from '{}'...\033[1;m".format(
                gandalf_host.split("/")[-1]
            )
        )
        if (
            "GNU/Linux" in os_platform
            and "Linux" in os_platform
            and "Darwin" not in os_platform
        ):  # linux
            subprocess.Popen(
                [
                    "sudo ls -abiluQR --author --full-time / > /tmp/gandalf/gandalf/acquisitions/{}/LastAccessTimes.txt 2> /dev/null".format(
                        gandalf_host.split("/")[-1]
                    )
                ],
                shell=True,
            ).communicate()
            print("       \033[1;32mObtained files' LastAccess times\033[1;m")
        elif (
            "Darwin" in os_platform
            and "GNU/Linux" not in os_platform
            and "Linux" not in os_platform
        ):  # macOS
            subprocess.Popen(
                [
                    "sudo ls -@aBFgilRu / > /tmp/gandalf/gandalf/acquisitions/{}/LastAccessTimes.txt 2> /dev/null".format(
                        gandalf_host.split("/")[-1]
                    )
                ],
                shell=True,
            ).communicate()
            print("       \033[1;32mObtained files' LastAccess times\033[1;m")
        else:
            print(
                "      \033[1;31mUnable to acquire files' LastAccess times; platform is neither Linux or macOS.\033[1;m"
            )
    else:
        pass
    if collect_files != "None":
        print()
        print(
            "      \033[1;32mCollecting files from '{}'...\033[1;m".format(
                gandalf_host.split("/")[-1]
            )
        )
        for collect_files_root, _, collect_files_files in os.walk("/"):
            for collect_files_file in collect_files_files:
                file_to_collect = os.path.join(collect_files_root, collect_files_file)
                if (
                    os.path.isfile(file_to_collect)
                    and "/tmp/gandalf/gandalf/" not in file_to_collect
                ):
                    with open("lists/files.list") as files_list:
                        for filename in files_list:
                            if filename == collect_files_file:
                                try:
                                    print(
                                        "       Found '\033[1;32m{}\033[1;m' in '\033[1;32m{}\033[1;m'...".format(
                                            filename,
                                            file_to_collect.replace(filename, ""),
                                            gandalf_host.split("/")[-1],
                                        )
                                    )
                                    if not os.path.exists(
                                        os.path.join(output_directory, "files")
                                    ):
                                        os.mkdir(
                                            os.path.join(output_directory, "files")
                                        )
                                    else:
                                        pass
                                    shutil.copy2(
                                        file_to_collect,
                                        os.path.join(
                                            output_directory,
                                            "files",
                                            "{}+{}+{}".format(
                                                collect_files_root.split("/")[1],
                                                collect_files_root.split("/")[-1],
                                                collect_files_file,
                                            ),
                                        ),
                                    )
                                except:
                                    pass
                            else:
                                pass
                else:
                    pass
    else:
        pass
    for collected_root, collected_dirs, collected_files in os.walk(gandalf_directory):
        for collected_dir in collected_dirs:
            os.chmod(os.path.join(collected_root, collected_dir), 0o755)
        for collected_file in collected_files:
            os.chmod(os.path.join(collected_root, collected_file), 0o755)
    os.chmod(gandalf_directory, 0o755)
    archive_artefacts(encryption, encryption_object, gandalf_directory, gandalf_host)
