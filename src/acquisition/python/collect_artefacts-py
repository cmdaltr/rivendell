MACOS_SINGLE_FILES = {
    # file -> (folder under artefacts/, name) for single files the main loop's
    # directory walk can't pick up
    "/Library/Application Support/com.apple.TCC/TCC.db": ("tcc", "system+TCC.db"),
    "/private/var/db/CoreDuet/Knowledge/knowledgeC.db": ("coreduet", "system+knowledgeC.db"),
    "/System/Library/CoreServices/SystemVersion.plist": ("plists", "systemversion+SystemVersion.plist"),
    "/etc/sudoers": ("conf", "etc+sudoers"),
    "/etc/ssh/sshd_config": ("conf", "etc+ssh+sshd_config"),
}
MACOS_USER_FILES = (
    ".zsh_history", ".zshrc", ".zprofile", ".zshenv", ".profile",
)
SHARED_MAX_BYTES = 10 * 1024 * 1024


def _collect_one(source, destination, gandalf_host):
    """Copy one file (if readable and not empty), log it and hash it."""
    try:
        if not os.path.isfile(source) or os.path.getsize(source) == 0:
            return False
        os.makedirs(os.path.dirname(destination), exist_ok=True)
        shutil.copy2(source, destination)
    except (PermissionError, OSError):
        return False
    audit_log(gandalf_host, source)
    return True


def collect_macos_extras(gandalf_artefact_destination, gandalf_host):
    """
    macOS artefacts the system_artefacts walk misses: zsh history (the default
    shell since 10.15), per-user LaunchAgents and preferences, quarantine
    events, TCC and KnowledgeC databases. Protected files need Full Disk Access
    and are skipped otherwise.
    """
    dest = gandalf_artefact_destination
    for source, (folder, name) in MACOS_SINGLE_FILES.items():
        _collect_one(source, os.path.join(dest, folder, name), gandalf_host)
    for agents_dir, prefix in (
        ("/System/Library/LaunchAgents", "system+launchagents-"),
    ):
        if os.path.isdir(agents_dir):
            for plist in sorted(listdir_readable(agents_dir)):
                if plist.endswith(".plist"):
                    _collect_one(os.path.join(agents_dir, plist), os.path.join(dest, "plists", prefix + plist), gandalf_host)
    for user in sorted(listdir_readable("/Users")) if os.path.isdir("/Users") else []:
        home = os.path.join("/Users", user)
        if user == "Shared" or user.startswith(".") or not os.path.isdir(home):
            continue
        for name in MACOS_USER_FILES:
            _collect_one(os.path.join(home, name), os.path.join(dest, "user", user, name), gandalf_host)
        for sessions in (".zsh_sessions", ".bash_sessions"):
            sdir = os.path.join(home, sessions)
            if os.path.isdir(sdir):
                for name in sorted(listdir_readable(sdir)):
                    if name.endswith(".history"):
                        _collect_one(os.path.join(sdir, name), os.path.join(dest, "user", user, "sessions", name), gandalf_host)
        for subdir, prefix in (("LaunchAgents", user + "+launchagents+"), ("Preferences", user + "+")):
            pdir = os.path.join(home, "Library", subdir)
            if os.path.isdir(pdir):
                for plist in sorted(listdir_readable(pdir)):
                    if plist.endswith(".plist"):
                        _collect_one(os.path.join(pdir, plist), os.path.join(dest, "plists", prefix + plist), gandalf_host)
        _collect_one(
            os.path.join(home, "Library", "Preferences", "com.apple.LaunchServices.QuarantineEventsV2"),
            os.path.join(dest, "user", user, "QuarantineEventsV2"),
            gandalf_host,
        )
        _collect_one(
            os.path.join(home, "Library", "Application Support", "com.apple.TCC", "TCC.db"),
            os.path.join(dest, "tcc", user + "+TCC.db"),
            gandalf_host,
        )
    print(
        "      \033[1;32mAcquired macOS shell history and persistence artefacts from '{}'\033[1;m".format(
            gandalf_host.split("/")[-1]
        )
    )


# macOS artefacts beyond the extras above, into artefacts/macos/ under their path
# with '/' as '+'. Elrond's collect/mac.py and gandalf.sh carry the same lists.
# SQLite databases come with their -wal so uncheckpointed rows aren't lost.
MACOS_EXTRA_DATABASES = (
    "/private/var/db/SystemPolicyConfiguration/ExecPolicy", "/private/var/db/SystemPolicyConfiguration/KextPolicy",
    "/private/var/protected/xprotect/XPdb", "/private/var/db/com.apple.backgroundtaskmanagement/BackgroundItems-v*.btm",
    "/private/var/folders/*/*/0/com.apple.notificationcenter/db2/db",
)
MACOS_EXTRA_FILES = (
    "/Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist", "/private/etc/periodic.conf",
    "/private/etc/daily.local", "/private/etc/weekly.local", "/private/etc/monthly.local", "/private/etc/launchd.conf",
    "/private/etc/rc.common", "/Library/Receipts/InstallHistory.plist",
)
MACOS_POWERLOG = "/private/var/db/powerlog/Library/BatteryLife/CurrentPowerlog.PLSQL"
MACOS_EXTRA_DIRS = (("/private/etc/periodic", 2), ("/private/etc/emond.d", 2), ("/private/var/db/emondClients", 1))
MACOS_BIOME_MAX_FILES = 2000
MACOS_UNIFIED_LOG_PREDICATE = (
    'process IN {"sudo","su","sshd","sshd-session","loginwindow","screensharingd","syspolicyd","XprotectService",'
    '"backgroundtaskmanagementd","authd"} OR subsystem IN {"com.apple.TCC","com.apple.xprotect",'
    '"com.apple.syspolicy.exec","com.apple.backgroundtaskmanagement"}'
)
MACOS_UNIFIED_LOG_MAX_EVENTS = 500000


def collect_macos_staging(gandalf_artefact_destination, gandalf_host):
    """
    The macOS artefacts that change soonest after the temp directories:
    /Users/Shared (a common staging folder) and a filtered unified-log export
    (G17). The log store runs to gigabytes, so the export takes security-relevant
    processes and subsystems over GANDALF_UNIFIED_LOG_WINDOW (default 1d),
    capped at 500,000 events. Runs between the temp directories and the logs.
    """
    dest = gandalf_artefact_destination
    shared = "/Users/Shared"
    for root, dirs, files in os.walk(shared):
        if root[len(shared):].count(os.sep) >= 3:
            dirs[:] = []
        for name in files:
            source = os.path.join(root, name)
            try:
                if os.path.getsize(source) > SHARED_MAX_BYTES:
                    continue
            except OSError:
                continue
            rel = os.path.relpath(source, shared).replace(os.sep, "+")
            _collect_one(source, os.path.join(dest, "shared", rel), gandalf_host)
    macos = os.path.join(dest, "macos")
    if shutil.which("log"):
        os.makedirs(macos, exist_ok=True)
        export = os.path.join(macos, "gandalf+unifiedlog.ndjson")
        command = ["log", "show", "--last", os.environ.get("GANDALF_UNIFIED_LOG_WINDOW", "1d"), "--style", "ndjson",
                   "--predicate", MACOS_UNIFIED_LOG_PREDICATE]
        try:
            process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            with open(export, "wb") as out:
                for count, line in enumerate(process.stdout):
                    if count >= MACOS_UNIFIED_LOG_MAX_EVENTS:
                        break
                    out.write(line)
            process.kill()
            process.wait()
        except OSError:
            pass
        if os.path.isfile(export) and os.path.getsize(export) > 0:
            audit_log(gandalf_host, "unified log export")
    print(
        "      \033[1;32mAcquired macOS staging folder and unified-log export from '{}'\033[1;m".format(
            gandalf_host.split("/")[-1]
        )
    )


def collect_macos_more(gandalf_artefact_destination, gandalf_host):
    """
    BTM login and background items, shared file lists, Notification Center,
    ExecPolicy, KextPolicy, XProtect, emond, periodic, InstallHistory, PowerLog,
    and Biome streams.
    """
    macos = os.path.join(gandalf_artefact_destination, "macos")

    def take(source, limit=64 << 20):
        try:
            if not os.path.isfile(source) or os.path.islink(source) or os.path.getsize(source) > limit:
                return
        except OSError:
            return
        _collect_one(source, os.path.join(macos, source.lstrip("/").replace("/", "+")), gandalf_host)

    for pattern in MACOS_EXTRA_DATABASES:
        for source in sorted(glob.glob(pattern)):
            take(source)
            take(source + "-wal")
    take(MACOS_POWERLOG, 256 << 20)
    take(MACOS_POWERLOG + "-wal", 256 << 20)
    for source in MACOS_EXTRA_FILES:
        take(source)
    for top, depth in MACOS_EXTRA_DIRS:
        if os.path.isdir(top):
            for source in _walk_files(top, depth):
                take(source, 1 << 20)
    homes = [os.path.join("/Users", u) for u in sorted(listdir_readable("/Users")) if u != "Shared"] if os.path.isdir("/Users") else []
    biome_roots = ["/private/var/db/biome/streams/restricted"]
    for home in homes + ["/var/root"]:
        if not os.path.isdir(home):
            continue
        support = os.path.join(home, "Library", "Application Support")
        take(os.path.join(support, "com.apple.backgroundtaskmanagementagent", "backgrounditems.btm"))
        notifications = os.path.join(home, "Library", "Group Containers", "group.com.apple.usernoted", "db2", "db")
        take(notifications)
        take(notifications + "-wal")
        shared = os.path.join(support, "com.apple.sharedfilelist")
        if os.path.isdir(shared):
            for source in _walk_files(shared, 2):
                if source.endswith((".sfl2", ".sfl3")):
                    take(source, 10 << 20)
        biome_roots.append(os.path.join(home, "Library", "Biome", "streams", "restricted"))
    biome = 0
    for root in biome_roots:
        if os.path.isdir(root):
            for source in _walk_files(root, 4):
                if biome >= MACOS_BIOME_MAX_FILES:
                    break
                take(source, 10 << 20)
                biome += 1
    print(
        "      \033[1;32mAcquired macOS background items and policy databases from '{}'\033[1;m".format(
            gandalf_host.split("/")[-1]
        )
    )


