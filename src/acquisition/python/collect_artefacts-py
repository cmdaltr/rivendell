def audit_log(gandalf_host, artefact):
    now_time = "{}Z".format(str(datetime.now()).replace(" ", "T"))
    with open(os.path.join(gandalf_host, "log.audit"), "a") as gandalf_audit:
        gandalf_audit.write(
            "{},{},{},collected\n".format(
                now_time, gandalf_host.split("/")[-1], artefact
            )
        )


def write_manifest(gandalf_host):
    """SHA-256 of every collected file, by its path in the archive, into log.meta. Run
    once everything is copied, so hashing doesn't widen the window in which the live
    system changes under the collection; Elrond checks the hashes on arrival."""
    manifest = os.path.join(gandalf_host, "log.meta")
    count = 0
    with open(manifest, "w", newline="") as gandalf_meta:
        writer = csv.writer(gandalf_meta)
        writer.writerow(["hostname", "file_path", "sha256_hash"])
        for root, _, files in os.walk(gandalf_host):
            for name in sorted(files):
                path = os.path.join(root, name)
                # log.audit is still being written (this pass adds to it), so it isn't hashed
                if path in (manifest, os.path.join(gandalf_host, "log.audit")):
                    continue
                try:
                    digest = _sha256_file(path)
                except OSError:
                    digest = "unreadable"
                writer.writerow([gandalf_host.split("/")[-1], os.path.relpath(path, gandalf_host), digest])
                count += 1
    audit_log(gandalf_host, "log.meta ({} files hashed)".format(count))


