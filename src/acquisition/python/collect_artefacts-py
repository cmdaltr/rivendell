                                        gandalf_artefact_destination,
                                        artefact_output_dir,
                                        tmpobject,
                                    ),
                                )
                            else:
                                pass
                    else:
                        pass
                    if artefact_output_dir == "logs":
                        make_artefact_dir(
                            gandalf_artefact_destination, artefact_output_dir
                        )
                        if os.path.basename(gandalfroot) in LOGS_OWN_ENTRY:
                            gandalfdirs[:] = []
                            continue
                        for gandalffile in gandalffiles:
                            artefact_path = os.path.join(gandalfroot, gandalffile)
                            if os.path.isfile(artefact_path) and not os.path.islink(artefact_path) and \
                                    os.path.getsize(artefact_path) <= LOGS_MAX_BYTES:
                                copy_file(
                                    artefact_path,
                                    os.path.join(
                                        gandalf_artefact_destination,
