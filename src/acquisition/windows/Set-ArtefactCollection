    function Copy-Artefact {
        Param ($Source, $Destination)
        # A plain copy, else off the raw volume. Returns "copied", "raw" or $null.
        $Parent = Split-Path -Parent $Destination
        if (-Not (Test-Path -LiteralPath $Parent)) { New-Item -Path $Parent -ItemType Directory -Force > $null }
        # .NET resolves relative paths against its own working directory, not PowerShell's location
        $Destination = Join-Path (Resolve-Path -LiteralPath $Parent).ProviderPath (Split-Path -Leaf $Destination)
        if ($Source -notmatch ':[^\\]+$' -or $Source.Length -le 3) {
            try { [System.IO.File]::Copy($Source, $Destination, $true); return "copied" } catch { }
        }
        try { [void](Get-RawVolume $Source).CopyFile($Source, $Destination); return "raw" } catch { return $null }
    }
    function Get-RawTree {
        Param ($Path, $Recurse)
        # Files under a directory as the volume records them, for directories
        # Get-ChildItem can't list (DetectionHistory, other users' recycle bins)
        $Volume = Get-RawVolume $Path
        ForEach ($Name in $Volume.List($Path)) {
            $Child = "$Path\$Name"
            if ($Volume.IsDirectory($Child)) { if ($Recurse) { Get-RawTree $Child $Recurse } }
            else { $Child }
        }
    }
    function Copy-ArtefactTree {
        Param ($ShowProgress, $OutputDirectory, $Hostnames, $Label, $Source, $Folder, $Prefix, $Filter, $Recurse, $Raw)
        # Each file under $Source (matching $Filter) to raw\$Folder\<Prefix>+<path below
        # $Source, \ as +>. Returns how many were collected.
        $Collected = 0
        $Files = @()
        # Test-Path sees a directory whose ACL refuses a listing; a missing one isn't
        # worth indexing the volume for
        if (-Not $Raw -and -Not (Test-Path -LiteralPath $Source)) { return 0 }
        if (-Not $Raw) {
            $Listed = @(Get-ChildItem -LiteralPath $Source -File -Force -Recurse:$Recurse -ErrorAction SilentlyContinue -ErrorVariable Denied | ForEach-Object { $_.FullName })
            if ($Denied.Count -eq 0 -or $Listed.Count -gt 0) { $Files = $Listed } else { $Raw = $true }
        }
        if ($Raw) {
            try { $Files = @(Get-RawTree $Source $Recurse) } catch { $Files = @() }
        }
        ForEach ($File in $Files) {
            $Leaf = Split-Path -Leaf $File
            if ($Filter -and -Not ($Leaf -like $Filter)) { continue }
            $Relative = $File.Substring($Source.TrimEnd('\').Length).TrimStart('\') -replace '\\', '+'
            $Name = if ($Prefix) { "$Prefix+$Relative" } else { $Relative }
            $How = Copy-Artefact $File "$OutputDirectory\$Hostnames\artefacts\artefacts\raw\$Folder\$Name"
            if ($How) {
                $Collected++
                Add-LogEntry $ShowProgress $OutputDirectory $Hostnames "$Label ($File)" "acquired $Label '$File' ($How) from '$Hostnames'"
            }
        }
        return $Collected
    }
    function Copy-FromShadow {
        Param ($RelativePaths, $Destination)
        # Without RawCopy, locked files (Amcache.hve, SRUDB.dat) are copied from a
        # temporary shadow copy of C:, which is deleted straight afterwards.
        $Copied = @()
        $Shadow = $null
        # .NET resolves relative paths against its own working directory, not
        # PowerShell's location
        $Destination = (Resolve-Path -LiteralPath $Destination).ProviderPath
        try {
            $Created = (Get-WmiObject -List Win32_ShadowCopy).Create("C:\", "ClientAccessible")
            if ($Created.ReturnValue -ne 0) { return $Copied }
            $Shadow = Get-WmiObject Win32_ShadowCopy | Where-Object { $_.ID -eq $Created.ShadowID }
            ForEach ($RelativePath in $RelativePaths) {
                try {
                    [System.IO.File]::Copy("$($Shadow.DeviceObject)\$RelativePath", (Join-Path $Destination $RelativePath.Split("\\")[-1]), $true)
                    $Copied += $RelativePath
                }
                catch { }
            }
        }
        catch { }
        finally {
            if ($Shadow) { $Shadow.Delete() }
        }
        return ,$Copied
    }
    function Get-Core { 
        Param ($ShowProgress, $DriveLetter, $OutputDirectory, $Hostnames)
        
        $global:ProgressPreference = "SilentlyContinue"
        # disk_tools.zip only adds RawCopy, a fallback for the raw volume reader
        if (Test-Path -LiteralPath "$GandalfHome\tools\disk_tools.zip") {
            Expand-Archive -LiteralPath "$GandalfHome\tools\disk_tools.zip" -DestinationPath "$GandalfHome\tools"
        }
        $global:ProgressPreference = "Continue"

        $RawOutput = "$OutputDirectory\$Hostnames\artefacts\artefacts\raw"
        $RawOutputPath = (Resolve-Path -LiteralPath $RawOutput).ProviderPath

        # NTFS metafiles, off the raw volume: $MFT (record 0), $LogFile (record 2) and the
        # USN journal's $J stream, sparse ranges left out (they run to gigabytes)
        $Metafiles = @(
            @{ Name = '$MFT'; Record = 0; Stream = "" },
            @{ Name = '$LogFile'; Record = 2; Stream = "" },
            @{ Name = '$UsnJrnl'; Path = 'C:\$Extend\$UsnJrnl:$J' }
        )
        ForEach ($Metafile in $Metafiles) {
            $Name = $Metafile.Name
            try {
                Write-Progress "Acquiring $Name from '$Hostnames'..."
                $Out = Join-Path $RawOutputPath $Name
                if ($Metafile.ContainsKey("Path")) { $Bytes = (Get-RawVolume "C:").CopyFile($Metafile.Path, $Out) }
                else { $Bytes = (Get-RawVolume "C:").CopyRecord($Metafile.Record, $Metafile.Stream, $Out, $false) }
                Write-Host "       Acquired $Name from '$Hostnames' ($([Math]::Round($Bytes / 1MB)) MB)" -ForegroundColor Green
                Add-LogEntry $ShowProgress $OutputDirectory $Hostnames "$Name (raw volume read)" "acquired '$Name' from '$Hostnames'"
            }
            catch {
                Write-Host "      FAILURE: '$Name' could not be collected: $($_.Exception.Message)" -ForegroundColor Red
            }
        }
        Write-Progress -Activity "_" -Completed

        $global:ProgressPreference = "SilentlyContinue"
        $Architecture = Get-ComputerInfo | Select-Object OsArchitecture
        $Architecture = Out-String -InputObject $Architecture
        $Architecture = $Architecture -Replace '[\S\s]+(\d{2})-bit[\S\s]+', '$1'
        $global:ProgressPreference = "Continue"
        if ($Architecture -eq "64") { $RawCopyExe = "$GandalfHome\tools\RawCopy64.exe" } else { $RawCopyExe = "$GandalfHome\tools\RawCopy.exe" }
        $HaveRawCopy = Test-Path -LiteralPath $RawCopyExe

        # User Access Logs (Server), locked by the UAL service
        if (Test-Path -LiteralPath "C:\Windows\System32\LogFiles\Sum") {
            Write-Progress "Acquiring User Access Logs from '$Hostnames'..."
            $Ual = Copy-ArtefactTree $ShowProgress $OutputDirectory $Hostnames "User Access Log" "C:\Windows\System32\LogFiles\Sum" "." "" "*.mdb" $false $false
            if ($Ual -gt 0) { Write-Host "       Acquired User Access Logs from '$Hostnames'" -ForegroundColor Green }
            Write-Progress -Activity "_" -Completed
        }

        # Locked or in-use files: raw volume read, then RawCopy (tools\disk_tools.zip) if
        # it's there, then a temporary shadow copy
        $Artefacts = @("hiberfil.sys", "pagefile.sys", "swapfile.sys", "Windows\AppCompat\Programs\Amcache.hve", "Windows\INF\setupapi.dev.log", "Windows\System32\sru\SRUDB.dat")
        $FromShadow = @()
        ForEach ($Artefact in $Artefacts) {
            $ArtefactFile = $Artefact.Split("\\")[-1]
            if (-Not (Test-Path -LiteralPath C:\$Artefact)) { continue }
            Write-Progress "Acquiring '$ArtefactFile' from '$Hostnames'..."
            $How = Copy-Artefact "C:\$Artefact" (Join-Path $RawOutputPath $ArtefactFile)
            if (-Not $How -and $HaveRawCopy) {
                $global:ProgressPreference = "SilentlyContinue"
                & $RawCopyExe "/FileNamePath:C:\$Artefact" "/OutputPath:$RawOutputPath" > $null 2>&1
                $global:ProgressPreference = "Continue"
                if (Test-Path -LiteralPath (Join-Path $RawOutputPath $ArtefactFile)) { $How = "RawCopy" }
            }
            if ($How) {
                Write-Host "       Acquired $ArtefactFile from '$Hostnames'" -ForegroundColor Green
                Add-LogEntry $ShowProgress $OutputDirectory $Hostnames $ArtefactFile "acquired '$ArtefactFile' ($How) from '$Hostnames'"
            }
            elseif ($ArtefactFile -in @("Amcache.hve", "SRUDB.dat")) { $FromShadow += $Artefact }
            else { Write-Host "      FAILURE: '$ArtefactFile' could not be collected." -ForegroundColor Red }
            Write-Progress -Activity "_" -Completed
        }
        if ($FromShadow.Count -gt 0) {
            $Copied = Copy-FromShadow $FromShadow $RawOutput
            ForEach ($Artefact in $FromShadow) {
                $ArtefactFile = $Artefact.Split("\\")[-1]
                if ($Copied -contains $Artefact) {
                    Write-Host "       Acquired $ArtefactFile from '$Hostnames' (shadow copy)" -ForegroundColor Green
                    Add-LogEntry $ShowProgress $OutputDirectory $Hostnames "$ArtefactFile (temporary shadow copy)" "acquired '$ArtefactFile' from a temporary shadow copy on '$Hostnames'"
                }
                else {
                    Write-Host "      FAILURE: '$ArtefactFile' could not be collected." -ForegroundColor Red
                }
            }
        }
    }
