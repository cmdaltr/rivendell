    function Get-RawVolume {
        Param ($Volume)
        # Reads files straight off the NTFS volume, so locks and ACLs don't stop it
        # (hives, SRUDB.dat, Windows.edb, DetectionHistory) and metafiles ($LogFile,
        # $UsnJrnl:$J) read like files. Replaces RawCopy and Sleuth Kit's icat. One
        # reader per volume: the name index is built from $MFT on first use.
        if (-Not ("GandalfNtfs" -as [type])) {
            Add-Type -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Win32.SafeHandles;

// Reads files straight off an NTFS volume: boot sector -> $MFT -> a file's
// $DATA runs. Locks and ACLs don't apply (hives, SRUDB.dat, Windows.edb,
// DetectionHistory), and metafiles ($LogFile, $UsnJrnl:$J) read like files.
// C# 5, so Windows PowerShell 5.1's Add-Type compiles it.
public class GandalfNtfs : IDisposable
{
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    static extern SafeFileHandle CreateFile(string name, uint access, uint share, IntPtr security, uint disposition, uint flags, IntPtr template);

    const int Align = 4096;  // raw volume reads must be sector-aligned; 4096 covers 4Kn disks
    Stream disk;
    long volumeOffset;
    public long ClusterSize;
    public int RecordSize;
    List<long[]> mftRuns;    // {lcn (-1 = sparse), clusters}
    long mftBytes;
    Dictionary<long, List<KeyValuePair<string, long>>> children;
    Dictionary<long, bool> directories;  // not HashSet: that's System.Core

    public GandalfNtfs(string volume)
    {
        // GENERIC_READ, FILE_SHARE_READ|FILE_SHARE_WRITE, OPEN_EXISTING
        SafeFileHandle handle = CreateFile("\\\\.\\" + volume.TrimEnd('\\'), 0x80000000, 3, IntPtr.Zero, 3, 0, IntPtr.Zero);
        if (handle.IsInvalid) throw new IOException("cannot open \\\\.\\" + volume + " (error " + Marshal.GetLastWin32Error() + ")");
        Init(new FileStream(handle, FileAccess.Read, 1), 0);
    }

    public GandalfNtfs(Stream stream, long offset) { Init(stream, offset); }

    void Init(Stream stream, long offset)
    {
        disk = stream;
        volumeOffset = offset;
        byte[] boot = ReadAt(0, 512);
        if (Encoding.ASCII.GetString(boot, 3, 4) != "NTFS") throw new IOException("not an NTFS volume");
        int bytesPerSector = BitConverter.ToUInt16(boot, 0x0B);
        int sectorsPerCluster = boot[0x0D];
        if (sectorsPerCluster > 0x80) sectorsPerCluster = 1 << (256 - sectorsPerCluster);
        ClusterSize = (long)bytesPerSector * sectorsPerCluster;
        int recordField = (sbyte)boot[0x40];
        RecordSize = recordField < 0 ? 1 << -recordField : (int)(recordField * ClusterSize);

        long mftOffset = BitConverter.ToInt64(boot, 0x30) * ClusterSize;
        byte[] record0 = ReadAt(mftOffset, RecordSize);
        Fixup(record0, 0);
        // Enough of $MFT to find record 0's extension records, then all of it
        mftRuns = new List<long[]>();
        mftBytes = 0;
        foreach (Segment s in AttributesIn(record0, 0x80, "")) { mftRuns.AddRange(s.Runs); if (s.StartVcn == 0) mftBytes = s.DataSize; }
        List<Segment> full = DataSegments(0, "");
        mftRuns = new List<long[]>();
        foreach (Segment s in full) mftRuns.AddRange(s.Runs);
    }

    public void Dispose() { if (disk != null) disk.Dispose(); }

    // ---- reading -------------------------------------------------------

    byte[] ReadAt(long offset, int count)
    {
        byte[] buffer = new byte[count];
        ReadAt(offset, buffer, 0, count);
        return buffer;
    }

    void ReadAt(long offset, byte[] buffer, int at, int count)
    {
        long start = offset - (offset % Align);
        long end = offset + count;
        if (end % Align != 0) end += Align - end % Align;
        byte[] block = new byte[end - start];
        disk.Position = volumeOffset + start;
        int got = 0;
        while (got < block.Length)
        {
            int n = disk.Read(block, got, block.Length - got);
            if (n <= 0) break;
            got += n;
        }
        if (got < offset - start + count) throw new IOException("short read at volume offset " + offset);
        Buffer.BlockCopy(block, (int)(offset - start), buffer, at, count);
    }

    // count bytes from a run list's logical offset (one record, or a chunk of $MFT)
    void ReadVirtual(List<long[]> runs, long virtualOffset, byte[] buffer, int count)
    {
        long runStart = 0;
        int done = 0;
        foreach (long[] run in runs)
        {
            long runBytes = run[1] * ClusterSize;
            while (done < count && virtualOffset + done < runStart + runBytes)
            {
                long within = virtualOffset + done - runStart;
                int piece = (int)Math.Min(count - done, runBytes - within);
                if (run[0] < 0) Array.Clear(buffer, done, piece);
                else ReadAt(run[0] * ClusterSize + within, buffer, done, piece);
                done += piece;
            }
            runStart += runBytes;
            if (done >= count) return;
        }
        throw new IOException("offset " + virtualOffset + " is past the end of the run list");
    }

    bool Fixup(byte[] buffer, int at)
    {
        if (Encoding.ASCII.GetString(buffer, at, 4) != "FILE") return false;
        int usaOffset = BitConverter.ToUInt16(buffer, at + 4);
        int usaCount = BitConverter.ToUInt16(buffer, at + 6);
        if (usaCount < 2) return false;
        int stride = RecordSize / (usaCount - 1);
        for (int i = 1; i < usaCount; i++)
        {
            int end = at + stride * i - 2;
            if (buffer[end] != buffer[at + usaOffset] || buffer[end + 1] != buffer[at + usaOffset + 1]) return false;  // torn write
            buffer[end] = buffer[at + usaOffset + 2 * i];
            buffer[end + 1] = buffer[at + usaOffset + 2 * i + 1];
        }
        return true;
    }

    byte[] ReadRecord(long number)
    {
        byte[] record = new byte[RecordSize];
        ReadVirtual(mftRuns, number * RecordSize, record, RecordSize);
        if (!Fixup(record, 0)) throw new IOException("MFT record " + number + " is not a valid FILE record");
        return record;
    }

    // ---- attributes ----------------------------------------------------

    class Segment
    {
        public long StartVcn;
        public long DataSize;
        public long InitSize;
        public int Flags;
        public bool Resident;
        public byte[] Value;
        public List<long[]> Runs = new List<long[]>();
    }

    static string NameOf(byte[] r, int attr)
    {
        int length = r[attr + 9];
        return length == 0 ? "" : Encoding.Unicode.GetString(r, attr + BitConverter.ToUInt16(r, attr + 10), length * 2);
    }

    List<Segment> AttributesIn(byte[] r, uint type, string name)
    {
        List<Segment> found = new List<Segment>();
        int offset = BitConverter.ToUInt16(r, 0x14);
        while (offset + 16 <= RecordSize)
        {
            uint attrType = BitConverter.ToUInt32(r, offset);
            int length = (int)BitConverter.ToUInt32(r, offset + 4);
            if (attrType == 0xFFFFFFFF || length <= 0 || offset + length > RecordSize) break;
            if (attrType == type && (name == null || string.Equals(NameOf(r, offset), name, StringComparison.Ordinal)))
            {
                Segment s = new Segment();
                s.Flags = BitConverter.ToUInt16(r, offset + 12);
                if (r[offset + 8] == 0)
                {
                    s.Resident = true;
                    int valueLength = (int)BitConverter.ToUInt32(r, offset + 0x10);
                    s.Value = new byte[valueLength];
                    Buffer.BlockCopy(r, offset + BitConverter.ToUInt16(r, offset + 0x14), s.Value, 0, valueLength);
                    s.DataSize = valueLength;
                    s.InitSize = valueLength;
                }
                else
                {
                    s.StartVcn = BitConverter.ToInt64(r, offset + 0x10);
                    s.DataSize = BitConverter.ToInt64(r, offset + 0x30);
                    s.InitSize = BitConverter.ToInt64(r, offset + 0x38);
                    s.Runs = DecodeRuns(r, offset + BitConverter.ToUInt16(r, offset + 0x20), offset + length);
                }
                found.Add(s);
            }
            offset += length;
        }
        return found;
    }

    static List<long[]> DecodeRuns(byte[] r, int pos, int limit)
    {
        List<long[]> runs = new List<long[]>();
        long lcn = 0;
        while (pos < limit && r[pos] != 0)
        {
            int lengthBytes = r[pos] & 0x0F;
            int offsetBytes = (r[pos] >> 4) & 0x0F;
            long clusters = 0;
            for (int j = 0; j < lengthBytes; j++) clusters |= (long)r[pos + 1 + j] << (8 * j);
            if (offsetBytes == 0)
            {
                runs.Add(new long[] { -1, clusters });  // sparse
            }
            else
            {
                long delta = 0;
                for (int j = 0; j < offsetBytes; j++) delta |= (long)r[pos + 1 + lengthBytes + j] << (8 * j);
                if ((r[pos + lengthBytes + offsetBytes] & 0x80) != 0 && offsetBytes < 8) delta -= 1L << (8 * offsetBytes);  // signed
                lcn += delta;
                runs.Add(new long[] { lcn, clusters });
            }
            pos += 1 + lengthBytes + offsetBytes;
        }
        return runs;
    }

    byte[] ReadSegmentValue(Segment s)
    {
        if (s.Resident) return s.Value;
        byte[] value = new byte[s.DataSize];
        ReadVirtual(s.Runs, 0, value, (int)s.DataSize);
        return value;
    }

    // Every $DATA segment of a stream, following $ATTRIBUTE_LIST into extension records
    List<Segment> DataSegments(long number, string stream)
    {
        byte[] baseRecord = ReadRecord(number);
        List<Segment> lists = AttributesIn(baseRecord, 0x20, null);
        List<Segment> data = new List<Segment>();
        if (lists.Count == 0)
        {
            data = AttributesIn(baseRecord, 0x80, stream);
        }
        else
        {
            byte[] list = ReadSegmentValue(lists[0]);
            List<long> records = new List<long>();
            int at = 0;
            while (at + 0x1A <= list.Length)
            {
                uint type = BitConverter.ToUInt32(list, at);
                int length = BitConverter.ToUInt16(list, at + 4);
                if (length == 0) break;
                int nameLength = list[at + 6];
                string name = nameLength == 0 ? "" : Encoding.Unicode.GetString(list, at + list[at + 7], nameLength * 2);
                long reference = (long)(BitConverter.ToUInt64(list, at + 0x10) & 0xFFFFFFFFFFFFUL);
                if (type == 0x80 && name == stream && !records.Contains(reference)) records.Add(reference);
                at += length;
            }
            foreach (long reference in records)
                data.AddRange(AttributesIn(reference == number ? baseRecord : ReadRecord(reference), 0x80, stream));
        }
        data.Sort(delegate (Segment a, Segment b) { return a.StartVcn.CompareTo(b.StartVcn); });
        return data;
    }

    // ---- copying -------------------------------------------------------

    // Writes a stream to destination; with skipSparse, sparse ranges are left out
    // ($UsnJrnl:$J is gigabytes of them). Returns the bytes written.
    public long CopyRecord(long number, string stream, string destination, bool skipSparse)
    {
        List<Segment> segments = DataSegments(number, stream);
        if (segments.Count == 0) throw new IOException("MFT record " + number + " has no $DATA" + (stream == "" ? "" : ":" + stream));
        foreach (Segment s in segments)
            if ((s.Flags & 0x0001) != 0 || (s.Flags & 0x4000) != 0) throw new NotSupportedException("compressed or encrypted $DATA in MFT record " + number);

        long written = 0;
        using (FileStream output = new FileStream(destination, FileMode.Create, FileAccess.Write))
        {
            if (segments[0].Resident)
            {
                output.Write(segments[0].Value, 0, segments[0].Value.Length);
                return segments[0].Value.Length;
            }
            long remaining = segments[0].DataSize;
            // Past the initialised size NTFS reads zeros, whatever is on disk
            long initialised = segments[0].InitSize;
            long logical = 0;
            int chunk = (int)Math.Max(ClusterSize, (1048576 / ClusterSize) * ClusterSize);
            byte[] buffer = new byte[chunk];
            foreach (Segment s in segments)
            {
                foreach (long[] run in s.Runs)
                {
                    long left = Math.Min(run[1] * ClusterSize, remaining);
                    long position = run[0] * ClusterSize;
                    while (left > 0)
                    {
                        int piece = (int)Math.Min(chunk, left);
                        if (run[0] < 0)
                        {
                            if (!skipSparse) { Array.Clear(buffer, 0, piece); output.Write(buffer, 0, piece); written += piece; }
                        }
                        else
                        {
                            ReadAt(position, buffer, 0, piece);
                            if (logical + piece > initialised)
                            {
                                int keep = (int)Math.Max(0, initialised - logical);
                                Array.Clear(buffer, keep, piece - keep);
                            }
                            output.Write(buffer, 0, piece);
                            written += piece;
                            position += piece;
                        }
                        logical += piece;
                        left -= piece;
                        remaining -= piece;
                    }
                    if (remaining <= 0) return written;
                }
            }
        }
        return written;
    }

    // ---- names ---------------------------------------------------------

    // parent record -> (name, record), from every in-use base record's $FILE_NAME
    void BuildIndex()
    {
        children = new Dictionary<long, List<KeyValuePair<string, long>>>();
        directories = new Dictionary<long, bool>();
        int perChunk = Math.Max(1, 4194304 / RecordSize);
        byte[] chunk = new byte[perChunk * RecordSize];
        long records = mftBytes / RecordSize;
        for (long first = 0; first < records; first += perChunk)
        {
            int count = (int)Math.Min(perChunk, records - first);
            ReadVirtual(mftRuns, first * RecordSize, chunk, count * RecordSize);
            for (int i = 0; i < count; i++)
            {
                int at = i * RecordSize;
                if (!Fixup(chunk, at)) continue;
                int flags = BitConverter.ToUInt16(chunk, at + 0x16);
                if ((flags & 0x01) == 0 || BitConverter.ToUInt64(chunk, at + 0x20) != 0) continue;  // free, or an extension record
                long number = first + i;
                if ((flags & 0x02) != 0) directories[number] = true;
                byte[] record = new byte[RecordSize];
                Buffer.BlockCopy(chunk, at, record, 0, RecordSize);
                foreach (Segment s in AttributesIn(record, 0x30, null))
                {
                    if (!s.Resident || s.Value.Length < 0x42) continue;
                    if (s.Value[0x41] == 2) continue;  // DOS 8.3 alias
                    long parent = (long)(BitConverter.ToUInt64(s.Value, 0) & 0xFFFFFFFFFFFFUL);
                    string name = Encoding.Unicode.GetString(s.Value, 0x42, s.Value[0x40] * 2);
                    List<KeyValuePair<string, long>> list;
                    if (!children.TryGetValue(parent, out list)) { list = new List<KeyValuePair<string, long>>(); children[parent] = list; }
                    bool seen = false;
                    foreach (KeyValuePair<string, long> kv in list) if (kv.Value == number && string.Equals(kv.Key, name, StringComparison.OrdinalIgnoreCase)) seen = true;
                    if (!seen) list.Add(new KeyValuePair<string, long>(name, number));
                }
            }
        }
    }

    // "Windows\System32\config\SYSTEM" (drive optional) -> MFT record, or -1
    public long Resolve(string path)
    {
        if (children == null) BuildIndex();
        string trimmed = path;
        if (trimmed.Length >= 2 && trimmed[1] == ':') trimmed = trimmed.Substring(2);
        long current = 5;  // root directory
        foreach (string part in trimmed.Split(new char[] { '\\', '/' }, StringSplitOptions.RemoveEmptyEntries))
        {
            List<KeyValuePair<string, long>> list;
            if (!children.TryGetValue(current, out list)) return -1;
            long next = -1;
            foreach (KeyValuePair<string, long> kv in list)
                if (kv.Value != current && string.Equals(kv.Key, part, StringComparison.OrdinalIgnoreCase)) { next = kv.Value; break; }
            if (next < 0) return -1;
            current = next;
        }
        return current;
    }

    public bool IsDirectory(string path)
    {
        long number = Resolve(path);
        return number >= 0 && directories.ContainsKey(number);
    }

    // Names in a directory (files and subdirectories)
    public string[] List(string path)
    {
        long number = Resolve(path);
        List<string> names = new List<string>();
        List<KeyValuePair<string, long>> list;
        if (number >= 0 && children.TryGetValue(number, out list))
            foreach (KeyValuePair<string, long> kv in list) if (kv.Value != number && !names.Contains(kv.Key)) names.Add(kv.Key);
        return names.ToArray();
    }

    // "C:\$Extend\$UsnJrnl:$J" -> the $J stream of $UsnJrnl
    public long CopyFile(string path, string destination)
    {
        string stream = "";
        int slash = path.LastIndexOfAny(new char[] { '\\', '/' });
        int colon = path.IndexOf(':', Math.Max(slash, 2));
        if (colon > 0) { stream = path.Substring(colon + 1); path = path.Substring(0, colon); }
        long number = Resolve(path);
        if (number < 0) throw new FileNotFoundException("not found on the volume: " + path);
        return CopyRecord(number, stream, destination, stream == "$J");
    }
